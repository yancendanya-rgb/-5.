# Скопіюйте у файл .env (він не потрапляє в репозиторій) і задайте свої значення
PORT=3000
NODE_ENV=development
# Секрет для адмін-маршрутів. Згенеруйте: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=
# Шлях до файлу SQLite (на хмарній платформі — на постійному диску)
DATABASE_PATH=./data/zatyshna.db
# За зворотним проксі (Render, Railway) поставте 1
TRUST_PROXY=
TABLES_PER_SLOT=3
